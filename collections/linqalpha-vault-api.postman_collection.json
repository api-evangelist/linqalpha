            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_name\": \"<string>\",\n  \"content_type\": \"<string>\",\n  \"workspace\": \"personal\",\n  \"organization_id\": \"<uuid>\",\n  \"user_id\": \"<uuid>\",\n  \"user_email\": \"<email>\",\n  \"user_name\": \"<string>\"\n}",
