        {
          "id": "26c090ac-8482-4ce1-b7ed-cfd01fb95dea",
          "name": "Create Source Batch",
          "request": {
            "name": "Create Source Batch",
            "description": {
              "content": "Creates a new source batch container for organizing and managing related document sources. A source batch acts as a logical grouping that must be created before uploading any sources. The returned `source_batch_id` is required when creating sources and can be used to reference all contained sources in chat or search requests.\n\n**Workflow:**\n1. Create a source batch (this endpoint)\n2. Upload sources to the batch using the returned `source_batch_id`\n3. Use the `source_batch_id` in chat/search API requests to access all sources in the batch",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "source_batches"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<string>\",\n  \"user_id\": \"<string>\",\n  \"organization_id\": \"<uuid>\",\n  \"user_email\": \"<string>\",\n  \"user_name\": \"<string>\",\n  \"description\": \"<string>\"\n}",
