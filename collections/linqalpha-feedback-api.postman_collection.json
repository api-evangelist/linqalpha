          "id": "020aae7a-19e8-48f0-8907-a37d166168c4",
          "name": "Create Conversation Feedback",
          "request": {
            "name": "Create Conversation Feedback",
            "description": {
              "content": "Submits feedback for a specific conversation. Use this endpoint to collect user ratings and comments about the quality of AI responses. Feedback helps improve the service and can be used for quality monitoring.\n\n**Rating Options:**\n- `up`: Positive feedback indicating a helpful response\n- `down`: Negative feedback indicating an unsatisfactory response\n\n**Optional Fields:**\n- `message_id`: Target specific message within the conversation\n- `comment`: Additional text feedback from the user",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "conversations",
                ":conversation_id",
                "feedback"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "conversation_id",
                  "description": "(Required) The unique identifier of the conversation to provide feedback for"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": \"<string>\",\n  \"rating\": \"<string>\",\n  \"organization_id\": \"<string>\",\n  \"user_id\": \"<string>\",\n  \"user_email\": \"<string>\",\n  \"user_name\": \"<string>\",\n  \"message_id\": \"<string>\",\n  \"comment\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
